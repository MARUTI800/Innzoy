"$","p","0",{"children":"Hyderabad is a city of layers. Beneath the glass towers of Gachibowli and HITEC City lies one of the oldest geologic formations on Earth—granitic formations dating back 2.5 billion years."}],["$","p","1",{"children":"Begin at dawn among the Khajaguda rocks before the urban heat rises. Journey into the old city for Irani chai brewed slowly in copper urns with Osmania biscuits, and conclude your evening on the quiet terrace of our Jubilee Hills sanctuary."}]]}],["$","div",null,{"className":"pt-6 border-t border-[#141413]/8 flex items-center justify-between text-xs font-mono text-stone-500","children":[["$","span",null,{"children":"INNZOY EDITORIAL BUREAU"}],["$","span",null,{"className":"text-[#B89F7D] uppercase tracking-widest","children":"END OF DISPATCH"}]]}]]}]]}]}]
