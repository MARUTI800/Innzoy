p","0",{"children":"Modern travel has increasingly mirrored modern commerce: optimized, hurried, checklist-driven, and relentlessly documented on screens."}],["$","p","1",{"children":"At INNZOY, we invite guests to practice unhurried presence. Wake up without alarms. Watch the morning light shift across textured limestone walls. Read an entire chapter of a book without a notification chime."}],["$","p","2",{"children":"The stay is not merely a staging ground for external sightseeing. The stay itself is the destination."}]]}],["$","div",null,{"className":"pt-6 border-t border-[#141413]/8 flex items-center justify-between text-xs font-mono text-stone-500","children":[["$","span",null,{"children":"INNZOY EDITORIAL BUREAU"}],["$","span",null,{"className":"text-[#B89F7D] uppercase tracking-widest","children":"END OF DISPATCH"}]]}]]}]]}]}]
